# ---------------------------------------------------------------------------
# EsteticaFlow - variaveis de ambiente
# Copie para .env.local (dev) e configure no painel do provedor (producao).
# NUNCA versione o arquivo .env real.
# ---------------------------------------------------------------------------

# Conexao Postgres. Em producao use o pooler (porta 6543 no Supabase).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esteticaflow

# Segredo de assinatura do cookie de sessao. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=troque-este-valor-por-uma-string-aleatoria-de-no-minimo-32-caracteres

# URL publica da aplicacao (usada em links absolutos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bootstrap do administrador da plataforma (usado apenas por `yarn db:seed`)
SEED_SUPER_ADMIN_EMAIL=admin@esteticaflow.com.br
SEED_SUPER_ADMIN_SENHA=troque-esta-senha
SEED_SUPER_ADMIN_NOME=Administrador da Plataforma
